# Legal Case Management Platform — Frontend environment variables (TEMPLATE).
#
# Committed to version control; contains NO secrets. Only `NEXT_PUBLIC_*`
# variables are exposed to the browser, so never put a secret here.
# To get a working local setup:  cp .env.example .env.local

# --- API connection ---
# Base URL of the FastAPI backend (no trailing slash). The version prefix
# (/api/v1) is added by the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Session ---
# Must match REFRESH_COOKIE_NAME in the backend .env. Only the cookie *name* is
# needed (so server-side route protection can detect its presence); the value is
# httpOnly and never readable from JavaScript.
NEXT_PUBLIC_REFRESH_COOKIE_NAME=legal_platform_refresh
