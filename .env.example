# Legal Case Management Platform — Backend environment variables (TEMPLATE).
#
# This file is committed to version control and contains NO real secrets.
# To get a working local setup:  cp .env.example .env
# The values below are the local-development defaults and already match the
# services in docker-compose.yml, so a fresh copy works out of the box.
# `.env` (your real copy) is git-ignored — never commit it.

# --- Application ---
ENVIRONMENT=development           # development | production | testing
PROJECT_NAME=Legal Case Management Platform API
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true                        # local dev; MUST be false in production

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                    # false = readable console logs (dev); true = JSON (prod)

# --- API documentation ---
ENABLE_DOCS=true

# --- CORS / trusted hosts (comma-separated) ---
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*                   # local dev; set explicit hosts in production

# --- PostgreSQL (docker-compose: postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=3
DB_ECHO=false

# --- Redis (docker-compose: redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=3

# --- MinIO (docker-compose: minio) ---
# MINIO_SECRET_KEY must match MINIO_ROOT_PASSWORD in docker-compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_REGION=
MINIO_CONNECT_TIMEOUT=3
# Bucket holding case documents. Created automatically on the first upload.
MINIO_DOCUMENTS_BUCKET=legal-documents

# --- Document management ---
# Upload ceiling enforced by the API. Behind Nginx, keep `client_max_body_size`
# at least this large or oversized uploads are refused at the edge with a 413
# that carries none of the API's error envelope.
MAX_DOCUMENT_SIZE_MB=25
# Accepted file types (comma-separated). Narrowing this list restricts uploads
# for the deployment; it cannot widen them beyond the types the platform can
# serve (pdf, docx, doc, txt, jpg, jpeg, png).
ALLOWED_DOCUMENT_EXTENSIONS=pdf,docx,doc,txt,jpg,jpeg,png

# --- OCR processing ---
# OCR is the first stage of the AI pipeline: uploaded PDFs and images have their
# text extracted in the background. Two SYSTEM binaries are required and are not
# installed by pip — see the OCR section of requirements.txt. Without them,
# extraction records a failed run (error_code `engine_failure`); the uploaded
# document is untouched and the run can be retried once they are installed.
OCR_ENABLED=true
OCR_ENGINE=tesseract
# Tesseract language packs to load, `+`- or comma-separated. Each additional pack
# costs recognition time, so narrow this for a single-language deployment.
OCR_LANGUAGES=eng+fra+ara
# Resolution PDF pages are rendered at. 300 is Tesseract's recommended floor for
# scanned text; lower is markedly worse, higher costs time without improving it.
OCR_DPI=300
# Whole-run deadline in seconds, covering page rendering AND recognition.
OCR_TIMEOUT_SECONDS=180
# Pages read from a single document, so a large bundle yields a partial result
# rather than a guaranteed timeout.
OCR_MAX_PAGES=100
# Background OCR workers in the API process. Small on purpose: OCR saturates a
# CPU core per job and must not starve the request handlers.
OCR_WORKER_CONCURRENCY=2
# Absolute path to the Tesseract binary, when it is not on PATH (the default on
# Windows). Blank uses the library's own default.
# e.g. TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Directory holding the Poppler binaries (pdftoppm/pdfinfo) that pdf2image shells
# out to. Same reasoning as TESSERACT_CMD.
# e.g. POPPLER_PATH=C:\poppler\Library\bin
POPPLER_PATH=

# --- Qdrant (docker-compose: qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_TIMEOUT=3
# Collection holding document chunk embeddings. Created on the first indexing run
# if absent, at the width EMBEDDING_DIMENSIONS declares. An existing collection is
# never recreated: a width mismatch is reported and the run fails, because
# silently recreating it would delete every vector on the platform.
QDRANT_COLLECTION=document_chunks
# Vectors written per Qdrant request. One request per vector pays a round trip
# each; one request for a 900-page bundle is a payload large enough to time out.
QDRANT_UPSERT_BATCH_SIZE=128

# --- Document indexing (chunking + embeddings) ---
# The second stage of the AI pipeline. It reads the text OCR persisted, splits it
# into passages, embeds each one, and stores the vectors in Qdrant. Disabling it
# stops new work from being scheduled; existing indexes stay readable and
# re-indexable.
INDEXING_ENABLED=true
# Chunking strategy (see apps/api/services/chunking.py). An unrecognised value
# falls back to the default rather than failing startup.
INDEX_CHUNKER=recursive-character
# Target passage length in *characters*, and how much each passage repeats from
# its predecessor. Both change what a vector means, so both are recorded on every
# run: an index built at one setting is not comparable with one built at another.
# Overlap only takes effect when a passage is longer than the chunk size — a size
# that fits every paragraph whole never exercises it.
INDEX_CHUNK_SIZE=1000
INDEX_CHUNK_OVERLAP=200
# Passages read from a single document. A bound is what keeps a 900-page bundle
# from being a guaranteed timeout rather than a partial index.
INDEX_MAX_CHUNKS=5000
# Whole-run deadline, covering chunking, embedding, AND the vector writes.
# Enforced between stages, not inside them: neither the splitter nor the model
# accepts a deadline, so the honest guarantee is "no new stage begins after it".
INDEXING_TIMEOUT_SECONDS=900
# Background workers processing indexing jobs in this API process. Small, because
# each holds the embedding model's working memory and saturates a core while
# encoding. Its own pool, separate from OCR's: a backlog of scans must not delay
# every index, and a slow index must not stall every upload's extraction.
INDEXING_WORKER_CONCURRENCY=1

# --- Semantic search (retrieval) ---
# The third stage of the AI pipeline. It embeds a natural-language query with the
# SAME model indexing used and retrieves the nearest passages from Qdrant.
# Retrieval only: no answer generation, no summarization, and no LLM call.
# Disabling it refuses new searches; indexed documents are unaffected.
SEARCH_ENABLED=true
# Results returned when a request does not ask for a number, and the ceiling a
# request may ask for. The ceiling exists so one call cannot be used to enumerate
# a case file, and so the response stays a page rather than a dump.
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
# How far a caller may page into a result set. Vector search degrades with deep
# offsets — every skipped hit is still scored — and nobody reads past a few pages
# of relevance-ordered passages.
SEARCH_MAX_OFFSET=500
# Longest accepted query, in characters. A question, not a document: anything
# longer is a paste, and embedding it would silently truncate at the model's
# context window instead of saying so.
SEARCH_QUERY_MAX_LENGTH=1000
# Similarity floor applied when a request does not set its own. 0.0 keeps every
# hit Qdrant returns, which is the right default for cosine similarity on a
# multilingual model: a threshold that is right for French prose is wrong for an
# Arabic filing, so the platform does not guess one.
SEARCH_MIN_SCORE=0.0
# Ranking strategy (see apps/api/services/search_ranking.py). An unrecognised
# value falls back to the default rather than failing startup. The seam exists so
# a future cross-encoder reranker is one class rather than a redesign.
SEARCH_RANKER=similarity
# Ceiling on the number of documents a category/file-type filter may resolve to
# before being pushed into the vector query. Beyond it the request is refused and
# the caller is asked to narrow — silently truncating the set would drop matching
# documents with nothing to indicate it.
SEARCH_MAX_FILTER_DOCUMENTS=2000
# Whether the TEXT of a user's query may be written to the application log. OFF
# by default: the spec forbids logging queries carrying sensitive legal
# information unless policy explicitly allows it, and a lawyer's query is at
# least as revealing as the passage it finds. Every search is logged either way,
# correlated by a salted, non-reversible fingerprint of the query rather than by
# its text. Turn this on only for debugging, and only on a deployment whose logs
# are as protected as its documents.
SEARCH_LOG_QUERIES=false

# --- RAG pipeline (grounded answer generation) ---
# The fourth stage of the AI pipeline. It retrieves passages THROUGH the semantic
# search service above (never through Qdrant directly, so the caller's case scope
# is inherited rather than re-implemented), assembles a versioned prompt from
# them, invokes the configured language model once, and returns a grounded answer
# with a citation per source. Orchestration only: it manages no conversation and
# owns no UI — those belong to the AI Legal Assistant.
# Disabling it refuses new questions; documents, indexes, and search are
# unaffected.
RAG_ENABLED=true
# Passages retrieved per question. Deliberately smaller than the search page
# size: every passage is paid for twice, in the context window and in the model's
# attention, and a long tail of weak matches dilutes a grounded answer rather
# than improving it. Must not exceed SEARCH_MAX_LIMIT, because retrieval runs
# through the same service a user's search does.
RAG_RETRIEVAL_TOP_K=8
# Similarity floor for retrieved passages when a request does not set one. 0.0
# for the same reason SEARCH_MIN_SCORE is.
RAG_MIN_SCORE=0.0
# How much retrieved text may go into one prompt, in CHARACTERS. Characters
# rather than tokens for the reason INDEX_CHUNK_SIZE records: counting tokens
# needs the provider's tokenizer loaded, which is exactly the coupling the
# provider abstraction exists to prevent. ~24 000 characters is roughly 6-8k
# tokens, comfortably inside every model the platform targets.
RAG_MAX_CONTEXT_CHARACTERS=24000
# Ceiling on a single passage's contribution, so one very long chunk cannot
# consume a budget five passages would have used better. Retrieval quality comes
# from breadth of evidence.
RAG_MAX_PASSAGE_CHARACTERS=4000
# Longest accepted question, in characters. Must not exceed
# SEARCH_QUERY_MAX_LENGTH: the question IS the retrieval query one step later, so
# a longer one would be accepted here and refused by the service that embeds it.
RAG_QUESTION_MAX_LENGTH=1000
# Most sources placed in one prompt, and therefore most citations on one answer.
# Applied where the sources are chosen rather than where the citations are
# counted: a source the model is shown but cannot cite is one the reader can
# never check.
RAG_MAX_CITATIONS=10
# Whole-request deadline, covering retrieval AND generation. Checked BETWEEN
# stages rather than inside them — neither the search service nor a provider SDK
# accepts a deadline that can be moved mid-call — so the honest guarantee is "no
# new stage begins after the deadline". Must be at least LLM_TIMEOUT_SECONDS.
RAG_TIMEOUT_SECONDS=90
# Whether the TEXT of a user's question may be written to the application log.
# OFF by default, and separate from SEARCH_LOG_QUERIES because the two carry
# different risk: a search query is a phrase, a question put to the assistant is
# a sentence about a client's matter. Every question is logged either way,
# correlated by the SAME salted fingerprint a search for that text produces — so
# an operator can trace a failing question across both surfaces while learning
# nothing about the matter. There is deliberately NO switch that logs the answer.
RAG_LOG_QUESTIONS=false
# Which prompt template answers a question, and which version of it. Templates
# live in apps/api/prompts/ as versioned .j2 files under source control, so a
# prompt change is reviewable as a diff of the text actually sent to the model.
# Both values are recorded on every answer, so an evaluation run can compare two
# prompts rather than merely two days.
RAG_PROMPT_TEMPLATE=rag/answer
RAG_PROMPT_VERSION=1

# --- AI legal assistant (conversations) ---
# The fifth stage of the AI pipeline: the conversational surface over the RAG
# pipeline. It persists conversations and messages, streams answers, passes
# citations through unchanged, suggests follow-up questions, and collects
# feedback. It generates nothing itself — every answer is the pipeline's.
# Disabling it refuses new conversations and new messages; existing history stays
# readable, and POST /rag/answer is unaffected.
ASSISTANT_ENABLED=true
# Longest conversation title, in characters. A label in a list, not a summary.
ASSISTANT_TITLE_MAX_LENGTH=120
# Page sizes for the conversation list and for a transcript. The transcript's is
# larger because a conversation is read as a whole: paging every ten turns would
# make the common case several round trips.
ASSISTANT_PAGE_SIZE=20
ASSISTANT_MAX_PAGE_SIZE=100
ASSISTANT_MESSAGE_PAGE_SIZE=50
ASSISTANT_MAX_MESSAGE_PAGE_SIZE=200
# Prior turns carried into a follow-up so it can be resolved against what came
# before — "And when is it due?" retrieves the right material only if the
# question before it travels with it. Bounded in two independent ways: the turn
# count bounds how far back, the character budget bounds how much. Both matter,
# because every carried character widens the retrieval query.
# ASSISTANT_CONTEXT_MAX_CHARACTERS must be smaller than RAG_QUESTION_MAX_LENGTH.
ASSISTANT_CONTEXT_MESSAGES=4
ASSISTANT_CONTEXT_MAX_CHARACTERS=800
# Messages one conversation may hold. A conversation is a working thread, not an
# archive: past the ceiling the user starts a new one, which also keeps a
# transcript loadable in one page-sized request.
ASSISTANT_MAX_MESSAGES=500
# Whether answers may be streamed when the configured provider supports it.
# Turning it off makes every answer arrive whole, which is the same fallback a
# provider that cannot stream produces. Note that a **streamed** answer carries no
# token usage: providers report usage on a finished response, and there is not one
# — so a deployment that streams everything reports null token totals on
# /rag/metrics rather than a figure that silently omits its real traffic.
ASSISTANT_STREAMING_ENABLED=true
# Whether a successful, grounded answer is followed by suggested next questions.
# A second, small model call per answer — so it is a switch to turn off on a
# metered or rate-limited key. On gemini-2.5-flash's free tier (5 requests per
# minute, 20 per day) this **halves** the questions a day allows, so a free-tier
# deployment should set it to false. A failure to produce suggestions never fails
# the answer they would have followed.
ASSISTANT_SUGGESTIONS_ENABLED=true
ASSISTANT_SUGGESTION_COUNT=3
# Longest suggested follow-up, in characters. Must not exceed
# RAG_QUESTION_MAX_LENGTH — a suggestion the user cannot send is worse than no
# suggestion. One that comes back longer is dropped, never clipped: a truncated
# question changes meaning.
ASSISTANT_SUGGESTION_MAX_LENGTH=160
# Deadline for the suggestion call. Deliberately small: suggestions arrive after
# the answer, and one that takes as long as the answer costs more than it saves.
# Must not exceed LLM_TIMEOUT_SECONDS.
ASSISTANT_SUGGESTION_TIMEOUT_SECONDS=15
# Ceiling on the suggestion call's output. Three short questions are perhaps 60
# tokens, so this looks absurdly generous — and 256 was NOT enough. A live run
# against gemini-2.5-flash returned one suggestion cut off mid-word: it is a
# reasoning model, its internal thinking is charged against this same budget, and
# on that call the thoughts consumed roughly 250 of 256 tokens before a single
# visible one was emitted. Raise this, not lower it, when switching to another
# reasoning model. It is not a cost — headroom that is not used is not billed.
ASSISTANT_SUGGESTION_MAX_OUTPUT_TOKENS=1024
# Which prompt template produces those suggestions, and which version of it.
# Versioned in the filename exactly as the answer prompt is, for the same reason.
ASSISTANT_SUGGESTION_PROMPT_TEMPLATE=assistant/followups
ASSISTANT_SUGGESTION_PROMPT_VERSION=1

# --- Prompt templates ---
# Which prompt backend to use (see apps/api/services/prompts.py). An unrecognised
# value falls back to the default rather than failing startup.
PROMPT_LIBRARY=jinja-files

# --- LLM provider ---
# Which provider implementation to use (see apps/api/services/llm.py). Two ship:
#   * gemini  — Google Gemini through the google-genai SDK. The default, because
#               context/ai-architecture.md names it.
#   * litellm — the gateway context/architecture.md names, for OpenAI, Ollama,
#               Groq, OpenRouter, Anthropic, and anything else LiteLLM speaks.
#               `litellm` is NOT in requirements.txt: install it before selecting
#               this, or every question answers 503 `llm_unavailable`.
# An unrecognised value falls back to the default rather than failing startup: an
# API that refused to come up over an AI setting would take authentication,
# cases, and documents down with it.
LLM_PROVIDER=gemini
# The model. context/ai-architecture.md names gemini-2.5-flash: strong
# multilingual reasoning, a long context window, fast inference, and a free tier.
# Switching provider means changing this AND LLM_PROVIDER — a LiteLLM deployment
# uses its own naming ("ollama/mistral", "openai/gpt-4o-mini").
LLM_MODEL=gemini-2.5-flash
# Credential for the configured provider. Deliberately provider-neutral: the
# platform must not name a vendor in a setting every deployment sets. Get a
# Gemini key at https://aistudio.google.com/apikey.
#
# **Absent is handled rather than fatal.** Questions answer 503 with
# `llm_unavailable`, GET /rag/metrics reports `llm_available: false`, and
# authentication, cases, documents, OCR, indexing, and search are all unaffected
# — the same posture a missing Tesseract or a missing embedding model takes.
#
# **Free-tier quotas, measured rather than quoted:** gemini-2.5-flash allows
# **5 requests per minute and 20 per day**. Both are real limits for a legal team
# — twenty questions is one afternoon. A 429 is classified as transient and
# retried with backoff, but three attempts at 1s/2s cannot ride out a
# thirty-second window, so a free-tier deployment expecting bursts should raise
# LLM_RETRY_BACKOFF_SECONDS (8 gives 8s + 16s across three attempts, still inside
# LLM_TIMEOUT_SECONDS). The daily cap has no remedy but a paid key.
LLM_API_KEY=
# Sampling temperature. Low on purpose: this is a grounded legal assistant, and
# creative variation between two identical questions about the same filing is a
# defect rather than a feature.
LLM_TEMPERATURE=0.2
# Ceiling on one answer's length, in provider tokens. An answer cut off here is
# reported to the client as `truncated` rather than presented as complete.
LLM_MAX_OUTPUT_TOKENS=1024
# Deadline for a single provider call. The pipeline passes the SMALLER of this
# and whatever remains of RAG_TIMEOUT_SECONDS.
LLM_TIMEOUT_SECONDS=45
# Attempts per generation, including the first. Only transient failures are
# retried — a rejected credential retried three times is three refusals, slower
# and billed.
LLM_MAX_ATTEMPTS=3
# Base delay between retries, doubled per attempt (exponential backoff, as
# context/code-standards.md requires).
LLM_RETRY_BACKOFF_SECONDS=1.0

# --- Embeddings ---
# Which embedding backend to use (see apps/api/services/embedding.py).
EMBEDDING_BACKEND=sentence-transformers
# The model itself. context/ai-architecture.md names BAAI/bge-m3: multilingual,
# with strong Arabic and French retrieval, and the SAME model must be used for
# indexing and for future query embedding. **Changing it requires re-indexing
# every document** — which is why each index records the model it was built with,
# and why GET /indexing?embedding_model=... exists to find the stragglers.
#
# The model is ~2.3 GB and is downloaded from Hugging Face on FIRST USE, not at
# startup, into HF_HOME (default ~/.cache/huggingface). A deployment without it
# still starts and serves every other feature; indexing runs fail with
# `embedding_failure` and GET /indexing/metrics reports
# `embedding_available: false`, and every run can be rebuilt once it is present.
EMBEDDING_MODEL=BAAI/bge-m3
# Width of that model's vectors. Declared rather than probed so the Qdrant
# collection can be created before the model is ever loaded; a mismatch with the
# loaded model is detected and reported rather than written.
EMBEDDING_DIMENSIONS=1024
# Passages encoded per forward pass. Bounds peak memory during a run.
EMBEDDING_BATCH_SIZE=16
# Torch device the model runs on ("cpu", "cuda", "cuda:0"). Blank lets
# sentence-transformers pick, which is the right default on a host that may or
# may not have a GPU.
EMBEDDING_DEVICE=

# --- Authentication (JWT) ---
# JWT_SECRET_KEY signs every access and refresh token. The value below is an
# INSECURE development placeholder: the app REFUSES to start in production
# while it is set, and requires at least 32 characters there.
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256              # HS256 | HS384 | HS512
ACCESS_TOKEN_EXPIRE_MINUTES=15   # short-lived access token
REFRESH_TOKEN_EXPIRE_DAYS=7      # long-lived refresh token
JWT_ISSUER=legal-platform-api
JWT_AUDIENCE=legal-platform-web

# --- Password hashing (bcrypt) ---
BCRYPT_ROUNDS=12                 # cost factor; raise for stronger (slower) hashing

# --- Login throttling (brute-force protection) ---
# After MAX_FAILED_LOGIN_ATTEMPTS consecutive failures within
# LOGIN_FAILURE_WINDOW_MINUTES, login is refused with HTTP 429 for
# LOGIN_LOCKOUT_MINUTES. Tracked per account AND per client IP; a successful
# login clears the account's counter.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Set to true ONLY behind a reverse proxy (Nginx) that overwrites
# X-Forwarded-For. If enabled without a trusted proxy, clients can spoof the
# header to evade per-IP throttling or to get another user's IP blocked.
TRUST_PROXY_HEADERS=false

# --- Refresh token cookie ---
# The refresh token is sent as an httpOnly cookie so browser JS cannot read it.
REFRESH_COOKIE_NAME=legal_platform_refresh
REFRESH_COOKIE_SECURE=false      # local dev over HTTP; MUST be true in production
REFRESH_COOKIE_SAMESITE=strict   # lax | strict | none  (CSRF protection)
REFRESH_COOKIE_DOMAIN=           # blank = host-only cookie
